    {
      "parameters": {
        "jsCode": "// ============================================================\n// MAP PGM All_Members XLS columns -> pgm.members\n// NOTE: 第一次跑後查: SELECT jsonb_object_keys(raw_data) FROM pgm.members LIMIT 1;\n// 睇真實 column name，tune pick() 裡面嘅 key\n// ============================================================\nconst pick = (r, ...keys) => {\n  for (const k of keys) {\n    const v = r[k];\n    if (v !== undefined && v !== null && String(v).trim() !== '') return String(v).trim();\n  }\n  return null;\n};\nconst parseDate = (v) => {\n  if (!v) return null;\n  const s = String(v).trim();\n  if (/^\\d{4,6}$/.test(s)) {\n    const d = new Date((Number(s) - 25569) * 86400 * 1000);\n    return isNaN(d.getTime()) ? null : d.toISOString().slice(0, 10);\n  }\n  const d = new Date(s);\n  return isNaN(d.getTime()) ? null : d.toISOString().slice(0, 10);\n};\nconst parseNum = (v) => {\n  if (v === null || v === undefined || v === '') return null;\n  const n = Number(String(v).replace(/[,$\\s]/g, ''));\n  return isNaN(n) ? null : n;\n};\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  const firstName = pick(r, 'First Name', 'FirstName') || '';\n  const lastName  = pick(r, 'Last Name',  'LastName')  || '';\n  const fullName  = pick(r, 'Full Name', 'Name', 'Member Name', 'Client Name') || (firstName + ' ' + lastName).trim();\n  const rec = {\n    member_code:      pick(r, 'Member No', 'MemberNo', 'Member Code', 'MemberCode', 'ID', 'Member ID', 'Code', 'Client No'),\n    name:             fullName || null,\n    phone:            pick(r, 'Phone', 'Mobile', 'Mobile Phone', 'Phone Number', 'Tel', 'Telephone', 'Cell Phone'),\n    email:            pick(r, 'Email', 'E-mail', 'Email Address'),\n    gender:           pick(r, 'Gender', 'Sex'),\n    dob:              parseDate(pick(r, 'Date of Birth', 'DOB', 'Birthday', 'Birth Date')),\n    join_date:        parseDate(pick(r, 'Join Date', 'Registration Date', 'Joined', 'Member Since')),\n    plan_type:        pick(r, 'Membership Type', 'Product', 'Plan', 'Contract Type', 'Membership', 'Contract Name', 'Agreement'),\n    plan_start:       parseDate(pick(r, 'Contract Start', 'Membership Start', 'Plan Start', 'Start Date', 'Valid From')),\n    plan_end:         parseDate(pick(r, 'Contract End', 'Membership End', 'Plan End', 'End Date', 'Expiry Date', 'Expiry', 'Valid To')),\n    status:           pick(r, 'Status', 'Contract Status', 'Membership Status', 'Member Status'),\n    pt_sessions_left: Math.round(parseNum(pick(r, 'PT Sessions Left', 'PT Remaining', 'Sessions Left', 'Remaining Sessions', 'Classes Left')) || 0),\n    last_visit:       parseDate(pick(r, 'Last Visit', 'Last Check-in', 'Last Entry', 'Last Visited')),\n    total_paid:       parseNum(pick(r, 'Total Paid', 'Amount Paid', 'Revenue', 'Total', 'Paid Amount')),\n    branch:           pick(r, 'Branch', 'Club', 'Location', 'Home Club', 'Home Branch'),\n    notes:            pick(r, 'Notes', 'Remarks', 'Comment', 'Comments'),\n    raw_data:         r\n  };\n  if (!rec.member_code) continue;\n  out.push({ json: rec });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1140, 300],
      "id": "aa000001-0002-4000-8000-000000000002",
