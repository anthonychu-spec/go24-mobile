        "jsCode": "return items.map(item => {\n  const html = item.json.html || '';\n  const regex = /https:\\/\\/go24fitness-hk\\.perfectgym\\.com\\/Api\\/Reports\\/Download\\/[^\"]+/g;\n  const matches = html.match(regex);\n  if (!matches || matches.length === 0) return null;\n  let url = matches[0];\n  url = url.replace(/[>\\]\"')]+$/, '').replace(/\\+/g, '');\n  const parts = url.split('/');\n  const reportName = parts[6] || 'Report';\n  const today = new Date().toISOString().slice(0, 10);\n  return { json: { downloadUrl: url, reportName, filename: reportName + '_' + today + '.xlsx' } };\n}).filter(item => item !== null);"
