# ============================================
# GO24 Mobile — Environment Variables
# Copy to .env.local and fill in real values
# ============================================

# --- NestJS API ---
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# --- Postgres ---
DATABASE_URL=postgresql://go24:go24@localhost:5432/gym_members
POSTGRES_USER=go24
POSTGRES_PASSWORD=go24
POSTGRES_DB=gym_members

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Perfect Gym (PGM) API ---
PGM_API_BASE=https://your-gym.perfectgym.com/api
PGM_API_KEY=
PGM_API_SECRET=

# --- Adyen ---
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_HMAC_KEY=
ADYEN_ENV=TEST

# --- WhatsApp (via n8n) ---
N8N_WEBHOOK_WHATSAPP=http://localhost:5678/webhook/outbox-whatsapp

# --- Face matching (via n8n) ---
N8N_WEBHOOK_FACE_ENROLL=http://localhost:5678/webhook/face-enroll
N8N_WEBHOOK_FACE_MATCH=http://localhost:5678/webhook/face-match

# --- Expo / Mobile ---
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_ENV=development

# --- Sentry ---
SENTRY_DSN=
