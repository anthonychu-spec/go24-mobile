# ============================================
# GO24 Mobile — Environment Variables
# Copy to .env.local and fill in real values
# ============================================

# --- NestJS API ---
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# --- Postgres ---
DATABASE_URL=postgresql://go24:go24@localhost:5432/gym_members
POSTGRES_USER=go24
POSTGRES_PASSWORD=go24
POSTGRES_DB=gym_members

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Perfect Gym (PGM) API ---
# Confirmed: GO24 instance + B2B credentials in hand
PGM_API_BASE=https://go24fitness-hk.perfectgym.pl/Api/v2.2
PGM_CLIENT_ID=
PGM_CLIENT_SECRET=
PGM_OTP_DESTINATION=Email   # Confirmed: members use email
PGM_DEFAULT_CLUB_ID=        # for OpenGate / RegisterMemberVisit defaults

# --- Adyen ---
# Confirmed: PGM ClientPortal/GeneratePaymentLink uses Adyen internally.
# We DON'T integrate Adyen directly in Phase 1 — use PGM payment link.
# Adyen webhook still received via PGM, OR if direct webhook needed:
ADYEN_HMAC_KEY=             # for verifying webhook signatures (if direct)

# --- WhatsApp (via n8n) ---
N8N_WEBHOOK_WHATSAPP=http://localhost:5678/webhook/outbox-whatsapp

# --- Face matching (via n8n) ---
N8N_WEBHOOK_FACE_ENROLL=http://localhost:5678/webhook/face-enroll
N8N_WEBHOOK_FACE_MATCH=http://localhost:5678/webhook/face-match

# --- Expo / Mobile ---
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_ENV=development

# --- Sentry ---
SENTRY_DSN=
